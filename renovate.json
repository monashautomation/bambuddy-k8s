{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests", ":semanticCommits"],
  "labels": ["deps"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Bambuddy uses 3- and 4-part versions (1.3.2, 1.2.5.7); ignore the per-arch tags",
      "matchPackageNames": ["ghcr.io/maziggy/bambuddy"],
      "versioning": "loose",
      "allowedVersions": "/^\\d+(\\.\\d+){2,3}$/"
    },
    {
      "description": "Patch and minor releases deploy automatically after 3 days; majors need a review",
      "matchPackageNames": ["ghcr.io/maziggy/bambuddy"],
      "matchUpdateTypes": ["patch", "minor", "digest"],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
